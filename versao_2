const SEG = {'0': 'abcdef', '1': 'bc', '2': 'abged', '3': 'abgcd', '4': 'fgbc', '5': 'afgcd', '6': 'afgedc', '7': 'abc', '8': 'abcdefg', '9': 'abcdfg', '-': 'g', ' ': ''};
function segDigit(x0, ch, dp) {
  const on = SEG[ch] || '', w = 34, h = 70, t = 7, sk = 5, y0 = 10;
  const P = {
    a: [[t, 0], [w - t, 0], [w - t - 3, t], [t + 3, t]], d: [[t + 3, h - t], [w - t - 3, h - t], [w - t, h], [t, h]],
    g: [[t, h / 2 - t / 2], [w - t, h / 2 - t / 2], [w - t + 2, h / 2], [w - t, h / 2 + t / 2], [t, h / 2 + t / 2], [t - 2, h / 2]],
    f: [[0, t], [t, t + 3], [t, h / 2 - t / 2 - 1], [0, h / 2 - 2]], e: [[0, h / 2 + 2], [t, h / 2 + t / 2 + 1], [t, h - t - 3], [0, h - t]],
    b: [[w, t], [w, h / 2 - 2], [w - t, h / 2 - t / 2 - 1], [w - t, t + 3]], c: [[w, h / 2 + 2], [w, h - t], [w - t, h - t - 3], [w - t, h / 2 + t / 2 + 1]]
  };
  let s = '';
  for (const k in P) {
    const pts = P[k].map(([x, y]) => `${(x0 + x + sk * (1 - y / h)).toFixed(1)},${(y0 + y).toFixed(1)}`).join(' ');
    s += `<polygon points="${pts}" fill="${on.includes(k) ? 'var(--vfd)' : 'var(--vfd-off)'}"/>`;
  }
  return s + `<circle cx="${x0 + w + 6}" cy="${y0 + h - 3}" r="3.6" fill="${dp ? 'var(--vfd)' : 'var(--vfd-off)'}"/>`;
}
function segShow(id, value, decimals) {
  if (value >= 999.95 && decimals) { value = Math.round(value); decimals = 0; }
  const str = value.toFixed(decimals), dpIndex = str.indexOf('.');
  const digits = str.replace('.', '').padStart(4, ' ').slice(-4);
  const dpPos = dpIndex < 0 ? -1 : 4 - (str.length - 1 - dpIndex) - 1;
  let s = '';
  for (let i = 0; i < 4; i++) s += segDigit(6 + i * 56, digits[i], i === dpPos);
  $(id).innerHTML = s;
}

