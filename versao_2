  else if (m.e < a * 0.85) add('crit', 'Camada abaixo do alvo', `${fmt(m.e)} µm contra ${a}–${b} µm. Nesta condição, seriam necessários ~${Math.ceil(S.t * a / Math.max(m.e, .01))} min.`);
