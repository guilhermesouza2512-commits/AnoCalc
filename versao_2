/* ================= modelo (integrado no tempo) ================= */
const SOFT = 0.8, NSTEP = 90;
function model(p, alloyId) {
  const al = ALLOYS[alloyId || p.alloy], T = p.T;
  const V0 = 7.5 + 0.05 * p.Al + 0.06 * (20 - T) + al.v0;
  const rf0 = 4.0 * Math.exp(-0.05 * (T - 20)) * Math.pow(200 / p.C, 0.6) * (1 + 0.01 * p.Al) * al.rf;
  const kE = 0.012 * Math.exp(-0.08 * (T - 20));                 // Ω·dm² por µm de camada
  const rb = 0.9 * (p.d / 15) * Math.pow(200 / p.C, 0.9) * (1 + 0.03 * p.Al) * Math.exp(-0.02 * (T - 20));
  const vcellAt = (J, e) => V0 + SOFT * Math.log(Math.expm1(Math.max(J, 1e-7) * (rf0 + kE * e + rb) / SOFT));
  const vtotAt = (J, e) => vcellAt(J, e);
  const solveJ = (V, e) => { let lo = 0, hi = 40; for (let i = 0; i < 50; i++) { const m = (lo + hi) / 2; if (vtotAt(m, e) > V) hi = m; else lo = m; } return (lo + hi) / 2; };
  // aditivo redutor de dissolução (% v/v): efeito satura entre 1 e 2% (dados de campo da ficha técnica)
  const addS = 1 - Math.exp(-(p.add || 0) / 0.9);
  const etaOf = J => {
    const pen = 0.018 * (T - 20) + 0.0008 * (p.C - 200) + 0.45 * Math.max(0, 1 - J);   // perdas por dissolução química
    const penEff = pen > 0 ? pen * (1 - 0.75 * addS) : pen;
    const alE = al.eta < 0 ? al.eta * (1 - addS * ((al.sem.cu || 0) > 0 ? 0.35 : 0.15)) : al.eta;
    return clamp(clamp(0.90 - penEff - 0.002 * p.Al, 0.3, 0.92) + alE, 0.2, 0.95);
  };
  const dissRate = 0.01 * Math.exp(0.15 * (T - 20)) * (p.C / 200) * (1 + 0.01 * p.Al) * (1 - 0.55 * addS);   // µm/min dissolvidos na superfície
  const rampDur = Math.min(2, p.t / 2), dt = p.t / NSTEP;
  const ser = {tau: [], J: [], V: [], e: []};
  let e = 0, dissolved = 0, Jsum = 0, Vplat = null;
  for (let i = 0; i <= NSTEP; i++) {
    const tau = i * dt, f = rampDur > 0 ? Math.min(1, tau / rampDur) : 1;
    let J, V;
    if (p.mode === 'V') { V = p.V * f; J = solveJ(V, e); } else { J = p.J * f; V = vtotAt(J, e); }
    if (Vplat === null && f >= 1) Vplat = V;
    ser.tau.push(tau); ser.J.push(J); ser.V.push(V); ser.e.push(e);
    if (i < NSTEP) {
      const grow = 0.352 * J * etaOf(J);
      const d = Math.min(e + grow * dt, dissRate * dt);
      e = Math.max(0, e + grow * dt - d); dissolved += d; Jsum += J * dt;
    }
  }
  const J = ser.J[NSTEP], V = ser.V[NSTEP], Jmean = Jsum / p.t;
  const I = J * p.A, dB = J * rb;
  const dF = Math.max(0, V - V0 - dB), vFilm = Math.max(0, V - dB);
  const eta = etaOf(J), rate = e / p.t, growEnd = 0.352 * J * eta;
  const cell = 2.5 * vFilm;
  const pore = cell * 0.30 * clamp(1 + 0.02 * (T - 20), 0.45, 1.5) * Math.pow(p.C / 200, 0.3) * (1 + 0.25 * (al.sem.cu || 0));
  const barrier = 1.0 * vFilm;
  const P = V * I, q = V * J;
  const dissFrac = dissolved / Math.max(e + dissolved, 1e-6);
  const energy = ser.V.reduce((s, v, i) => s + v * ser.J[i] * p.A * dt / 60, 0) / 1000; // kWh
  let HV = (300 + 10 * (20 - (T - 6 * addS))) * Math.pow(190 / p.C, 0.3) * al.hard * (1 - 0.6 * clamp(dissFrac - 0.1, 0, 1));
  HV = clamp(HV, 90, 600);
  const burnJ = al.burnJ * (1 + 0.04 * Math.max(0, 20 - T)) * (1 + 0.25 * addS), qmax = (55 + 8 * Math.max(0, 20 - T)) * (1 + 0.25 * addS);
  const plateau = growEnd <= dissRate * 1.15 && p.t > 10;
  return {addS, al, V0, rf0, kE, rb, J, Jmean, V, Vplat: Vplat ?? V, I, dB, dF, vFilm, eta, rate, e, cell, pore, barrier,
    P, q, dissRate, dissFrac, energy, HV, burnJ, qmax, plateau, ser, vtot: j => vtotAt(j, e)};
}
